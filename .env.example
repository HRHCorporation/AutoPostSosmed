# Database Configuration — PostgreSQL (local or Vercel Postgres / Neon)
DATABASE_URL=postgresql://localhost:5432/autopost

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Threads OAuth (Meta Developer App)
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret

# App URL (http://localhost:3000 for local, https://your-domain.vercel.app for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# DeepSeek AI (optional — get key at platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Instagram OAuth (Meta Developer App — for comment-to-DM automation)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# Instagram Webhook verification token (any random string you choose)
WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token

# Cron Job Security Token
CRON_SECRET=your_random_secret_token

# ── Supabase (commented out — not used in local/Vercel Postgres mode) ──
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
